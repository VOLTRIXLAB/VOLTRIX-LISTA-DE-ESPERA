  (function () {
    var link = document.querySelector('[data-wl-scroll-focus]');
    if (!link) return;
    link.addEventListener('click', function () {
      setTimeout(function () {
        var input = document.getElementById('wl-name');
        if (input) input.focus();
      }, 400);
    });
  })();
</script>

