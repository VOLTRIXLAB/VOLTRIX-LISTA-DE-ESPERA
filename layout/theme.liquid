<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>
    {%- if request.page_type == 'index' -%}
      Voltrix — Suplemento 4 en 1: Hidratación, Energía, Foco y Recuperación
    {%- else -%}
      {{ page_title }} — Voltrix
    {%- endif -%}
  </title>

  {% if request.page_type == 'index' %}
    <meta name="description" content="Voltrix es el suplemento diario que reemplaza tus electrolitos, tu pre-entreno y tu adaptógeno — creatina, cafeína con L-teanina, KSM-66® y electrolitos en una sola toma. Únete a la lista de espera: guía gratis + 15% de descuento de fundador.">
  {% elsif page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% else %}
    <meta name="description" content="Voltrix: todo lo que necesitas para rendir cada día, en una sola toma. Únete a la lista de espera y recibe la Guía de Rendimiento Honesta gratis + 15% de descuento de fundador.">
  {% endif %}

  {% comment %} ── Open Graph (Facebook, WhatsApp, LinkedIn...) ── {% endcomment %}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{% if request.page_type == 'index' %}Voltrix — Hidratación, Energía, Foco y Recuperación en una sola toma{% else %}{{ page_title }}{% endif %}">
  <meta property="og:description" content="{% if request.page_type == 'index' %}Creatina, electrolitos, foco y recuperación en un solo bote. Únete a la lista de espera: guía gratis + 15% de descuento de fundador.{% else %}{{ page_description | default: 'Únete a la lista de espera y recibe la Guía de Rendimiento Honesta gratis + 15% de descuento de fundador.' | escape }}{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https:{{ 'logo-voltrix.png' | asset_url }}">
  <meta property="og:image:secure_url" content="https:{{ 'logo-voltrix.png' | asset_url }}">

  {% comment %} ── Twitter Card ── {% endcomment %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if request.page_type == 'index' %}Voltrix — Hidratación, Energía, Foco y Recuperación en una sola toma{% else %}{{ page_title }}{% endif %}">
  <meta name="twitter:description" content="{% if request.page_type == 'index' %}Creatina, electrolitos, foco y recuperación en un solo bote. Únete a la lista de espera: guía gratis + 15% de descuento de fundador.{% else %}{{ page_description | default: 'Únete a la lista de espera y recibe la Guía de Rendimiento Honesta gratis + 15% de descuento de fundador.' | escape }}{% endif %}">
  <meta name="twitter:image" content="https:{{ 'logo-voltrix.png' | asset_url }}">

  {% comment %} ── JSON-LD: Organization ── {% endcomment %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ shop.name }}",
    "url": "{{ shop.url }}",
    "logo": "https:{{ 'logo-voltrix.png' | asset_url }}"
  }
  </script>

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  <style>
    html, body { margin: 0; padding: 0; background: #0A0A1A; }
  </style>
</head>
<body>
  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
